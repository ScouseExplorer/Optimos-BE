ENVIRONMENT=development
PROJECT_NAME=Optimos API
VERSION=1.0.0
API_PREFIX=/api

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Resend account email delivery (required in production/staging)
RESEND_API_KEY=
EMAIL_FROM=
FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/optimos
AUTO_CREATE_TABLES=false

# Local PostgreSQL defaults (used by docker-compose.yml service)
POSTGRES_DB=optimos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Stripe billing (configure monthly recurring prices for subscription plans)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREDIT_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel
